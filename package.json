{
  "name": "salary-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Salary management UI for a 10,000-employee organisation",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node api.js && next dev -p 3000",
    "build": "node api.js && npm run build -w @salary/shared && next build",
    "start": "node api.js && next start -p 3000",
    "typecheck": "npm run typecheck -w @salary/shared && tsc --noEmit",
    "lint": "next lint",
    "test": "npm run test -w @salary/shared && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@salary/shared": "*",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
