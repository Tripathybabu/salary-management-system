// Salary Management System — data model
//
// The defining decision here is that compensation is stored as effective-dated,
// immutable rows rather than a mutable column on Employee. See docs/ARCHITECTURE.md §2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  UNDISCLOSED
}

enum JobLevel {
  L1
  L2
  L3
  L4
  L5
  L6
  L7
  L8
}

enum SalaryChangeReason {
  HIRE
  MERIT_INCREASE
  PROMOTION
  MARKET_ADJUSTMENT
  ROLE_CHANGE
  CORRECTION
  DEMOTION
}

enum PayFrequency {
  ANNUAL
  MONTHLY
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  costCentre String? @map("cost_centre")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

model Country {
  /// ISO 3166-1 alpha-2. Natural key: stable, universally understood, and it keeps
  /// employee rows readable without a join when debugging.
  code         String @id @db.Char(2)
  name         String
  /// Default currency for the country. Overridable per employee, since a contractor
  /// in Poland may legitimately be paid in EUR.
  currencyCode String @map("currency_code") @db.Char(3)

  employees Employee[]

  @@map("countries")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Human-facing identifier (ACME-00001). HR staff quote this, not the UUID.
  employeeCode String @unique @map("employee_code")

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique

  countryCode  String @map("country_code") @db.Char(2)
  departmentId String @map("department_id") @db.Uuid

  jobTitle       String           @map("job_title")
  level          JobLevel
  employmentType EmploymentType   @default(FULL_TIME) @map("employment_type")
  status         EmploymentStatus @default(ACTIVE)
  gender         Gender           @default(UNDISCLOSED)

  hireDate       DateTime  @map("hire_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date

  /// Self-relation. Present so the org structure is captured; hierarchy rollups are
  /// out of scope (see REQUIREMENTS.md §4) but the data would support them.
  managerId String? @map("manager_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  country    Country    @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  manager    Employee?  @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[] @relation("ReportsTo")

  salaryRecords SalaryRecord[]

  // Indexes are driven by the actual query shapes in employee.service.ts and
  // analytics.service.ts, not added speculatively.

  /// The dashboard's most common grouping.
  @@index([countryCode, departmentId, level])
  /// Nearly every query filters out leavers.
  @@index([status])
  /// Pay bands are computed per level within a country.
  @@index([level, countryCode])
  @@index([departmentId])
  /// Default list ordering.
  @@index([lastName, firstName])
  @@index([managerId])
  @@map("employees")
}

/// An effective-dated compensation record.
///
/// Rows are never updated except to set `effectiveTo` when superseded. A raise, a
/// correction, and a demotion are all new rows — which is what makes the salary
/// history, point-in-time reporting, and the audit trail possible.
model SalaryRecord {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Amount in the employee's local currency. DECIMAL, never a float — see
  /// docs/ARCHITECTURE.md §3.
  baseAmount Decimal @map("base_amount") @db.Decimal(14, 2)
  currency   String  @db.Char(3)

  /// The same amount normalised to USD, computed at write time from a fixed rate
  /// table. Stored rather than derived so historical reports stay reproducible: a
  /// report whose numbers move because an FX rate changed is a bug.
  baseAmountUsd Decimal @map("base_amount_usd") @db.Decimal(14, 2)

  /// Annualised USD. Denormalised so analytics never has to branch on pay frequency
  /// inside an aggregate query — a monthly-paid employee would otherwise understate
  /// payroll cost by 12x.
  annualAmountUsd Decimal @map("annual_amount_usd") @db.Decimal(14, 2)

  payFrequency PayFrequency @default(ANNUAL) @map("pay_frequency")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// NULL means "currently in effect". At most one such row per employee, enforced
  /// by a unique partial index in the migration.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  changeReason SalaryChangeReason @map("change_reason")
  note         String?            @db.VarChar(500)

  /// Audit fields. `changedBy` is a plain string rather than a user FK because there
  /// is no user table yet — the auth seam is documented in ARCHITECTURE.md §7.
  changedBy String   @default("system") @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Serves the "current salary" join, which is on the hot path of every list and
  /// analytics query. A partial WHERE effective_to IS NULL index is added in the
  /// migration; Prisma's schema language cannot express partial indexes.
  @@index([employeeId, effectiveTo])
  /// Salary history, newest first.
  @@index([employeeId, effectiveFrom(sort: Desc)])
  /// Trend queries scan by date.
  @@index([effectiveFrom])
  @@index([changeReason])
  @@map("salary_records")
}
